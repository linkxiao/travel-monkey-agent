# 邮件验证码。复制本文件为 .env 再填写。端口填 465，发信时走加密连接。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 服务端模型：三项都填了，页面就不再让用户填模型和密钥；只给登录用户用，每人每天限次数。
# LLM_PROVIDER 可选 deepseek / openai / anthropic / openrouter / google / xai / qwen / kimi / glm / siliconflow / custom（custom 需填 LLM_BASE_URL）
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
# 每人每天次数，不填默认 10
LLM_DAILY_LIMIT=

# 地图（二选一或都填；优先级：高德 > 天地图 > 本地直线估算）
# 天地图：个人可申请，国内稳定 https://passport.tianditu.gov.cn/register/ （应用类型选「服务器端」）
TIANDITU_KEY=
# 高德 Web 服务 Key（可选，能力更全但认证更麻烦） https://console.amap.com/dev/key/app
AMAP_KEY=


# 联网搜索：主源 + 可选备用（主源 HTTP/额度失败时自动换备用）
#   bocha  → https://open.bochaai.com/  （国内推荐）

#   tavily → https://tavily.com/(免费档通常有每月额度，一般不用绑卡)
# 打开 https://app.tavily.com 注册/登录
# Dashboard 里找到 API Keys，复制一把（一般以 tvly- 开头）
# SEARCH_FALLBACK_PROVIDER=tavily,key:tvly-xxxxxx 填进 SEARCH_FALLBACK_KEY里
文档：https://docs.tavily.com/documentation/quickstart

#   serper → https://serper.dev/
# 打开 https://serper.dev 注册
# Dashboard 复制 API Key
# SEARCH_FALLBACK_PROVIDER=serper,key:serper-xxxxxx 填进 SEARCH_FALLBACK_KEY里

# 推荐：主源博查，备用 Tavily 或 Serper
SEARCH_PROVIDER=bocha
SEARCH_KEY=
SEARCH_FALLBACK_PROVIDER=tavily/serper
SEARCH_FALLBACK_KEY=
